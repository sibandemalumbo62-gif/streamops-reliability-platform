# AWS Configuration
aws_region = "us-east-1"
environment = "prod"
project_name = "streamops"

# EKS Configuration
cluster_name = "streamops-cluster"
cluster_version = "1.28"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# Node Groups
node_groups = {
  general = {
    instance_types = ["t3.medium"]
    min_size      = 2
    max_size      = 5
    desired_size  = 2
  }
  memory = {
    instance_types = ["r5.large"]
    min_size      = 1
    max_size      = 3
    desired_size  = 1
  }
}

# Monitoring
enable_monitoring = true

# Database Configuration
db_master_password = "change-this-password-in-production"

# Alerts
alert_email = "alerts@example.com"
